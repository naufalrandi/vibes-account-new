  "quiz": {
   "passMark": 80,
   "questions": [
    {
     "id": "awqmtlew34y6007",
     "type": "single",
     "text": "When should an information security incident be reported?",
     "points": 1,
     "options": [
      {
       "id": "omtlew34y8402",
       "text": "As soon as it is detected or suspected",
       "correct": true
      },
      {
       "id": "omtlew34y6377",
       "text": "Only after it is fully resolved",
       "correct": false
      },
      {
       "id": "omtlew34y5042",
       "text": "Only if a manager asks about it",
       "correct": false
      }
     ]
    },
    {
     "id": "awqmtlew34y2080",
     "type": "truefalse",
     "text": "A near-miss with no actual data loss never needs to be reported.",
     "points": 1,
     "answerTrue": false
    },
    {
     "id": "awqmtlew34y2791",
     "type": "single",
     "text": "Who is responsible for reporting a suspected incident?",
     "points": 1,
     "options": [
      {
       "id": "omtlew34y6878",
       "text": "Any employee who detects or suspects it",
       "correct": true
      },
      {
       "id": "omtlew34y690",
       "text": "Only the IT department",
       "correct": false
      },
      {
       "id": "omtlew34y5592",
       "text": "Only top management",
       "correct": false
      }
     ]
    }
   ]
  }
