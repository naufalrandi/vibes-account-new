  "quiz": {
   "passMark": 80,
   "questions": [
    {
     "id": "awqmtlew34y1433",
     "type": "single",
     "text": "What should you do first if you suspect your work account password has been compromised?",
     "points": 1,
     "options": [
      {
       "id": "omtlew34y9103",
       "text": "Change the password immediately and report it",
       "correct": true
      },
      {
       "id": "omtlew34y299",
       "text": "Wait to see if anything happens",
       "correct": false
      },
      {
       "id": "omtlew34y9791",
       "text": "Share a new password with a colleague for safekeeping",
       "correct": false
      }
     ]
    },
    {
     "id": "awqmtlew34y4677",
     "type": "truefalse",
     "text": "It is acceptable to reuse your personal email password for work accounts.",
     "points": 1,
     "answerTrue": false
    },
    {
     "id": "awqmtlew34y4568",
     "type": "single",
     "text": "Where must confidential information be stored?",
     "points": 1,
     "options": [
      {
       "id": "omtlew34y3783",
       "text": "On approved, access-controlled systems",
       "correct": true
      },
      {
       "id": "omtlew34y6137",
       "text": "On any personal USB drive for convenience",
       "correct": false
      },
      {
       "id": "omtlew34y3148",
       "text": "In a public shared folder",
       "correct": false
      }
     ]
    },
    {
     "id": "awqmtlew34y6865",
     "type": "truefalse",
     "text": "Clicking links in unexpected emails is safe as long as the sender name looks familiar.",
     "points": 1,
     "answerTrue": false
    }
   ]
  }
