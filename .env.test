# Local test-run defaults so `npm test` boots without a developer/production .env.
# Loaded by test/setup.ts before the vitest suite touches src/config/env.ts.
# Points at a local Postgres instance -- provision one with:
#   createdb omnitenant_test
# (docker-compose.yml ships only the API; run Postgres yourself, e.g.
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16).
NODE_ENV=test
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/omnitenant_test
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/omnitenant_test
JWT_ACCESS_SECRET=test-access-secret-change-me-32-characters
JWT_REFRESH_SECRET=test-refresh-secret-change-me-32-characters
