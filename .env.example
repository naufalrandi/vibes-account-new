NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnitenant
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/omnitenant_test
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
# Public frontend URL (http/https) that emailed links point at; trailing slash is
# stripped. Production refuses to boot if this is localhost/127.0.0.1.
APP_BASE_URL=http://localhost:3000
# --- outbound email (SMTP) ---
# Leave SMTP_HOST empty in development to print emails (with their links) to the
# console instead. Production refuses to boot without SMTP_HOST and MAIL_FROM.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vibes <no-reply@example.com>"
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Auth endpoint rate limiting (per client IP). Tighten in production.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Stricter per-IP limit on POST /auth/login and /auth/password/forgot.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Express `trust proxy`. 0 = trust no proxy (req.ip can't be spoofed via
# X-Forwarded-For). Behind a load balancer / TLS terminator set the hop count
# (e.g. 1) or a comma-separated list of proxy addresses/subnets — otherwise every
# client shares the proxy's IP for rate limits and login history.
TRUST_PROXY=0
# --- database pool / TLS ---
# DB_POOL_MAX must stay >= 2: boot-time migrations hold an advisory-lock
# transaction on one connection while they run on another.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
# true = require TLS to Postgres. Certificates are verified unless
# DB_SSL_REJECT_UNAUTHORIZED=false (only for a managed DB with a private CA).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Grace period (ms) for in-flight requests on SIGTERM/SIGINT before a forced exit.
SHUTDOWN_TIMEOUT_MS=10000
# --- AI connection ---
# Encrypts the AI provider API key saved under Organization Settings → AI
# (AES-256-GCM). Base64 of exactly 32 bytes: `openssl rand -base64 32`.
# Optional — without it the server runs but no AI key can be saved or used.
# Changing it makes the stored key unreadable (re-enter the key afterwards).
AI_ENCRYPTION_KEY=
# --- seeding (npm run db:seed only; not read by the server) ---
# Password every seeded login user gets. Required (12+ characters) — seeding
# refuses to run without it; there is no default.
SEED_PASSWORD=
