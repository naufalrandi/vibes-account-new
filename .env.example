NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnitenant
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/omnitenant_test
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
APP_BASE_URL=http://localhost:3000
# Auth endpoint rate limiting (per client IP). Tighten in production.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
